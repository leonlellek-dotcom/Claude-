# Datenbank
# Lokal (SQLite, ohne Setup):
DATABASE_URL="file:./dev.db"
# Produktion (PostgreSQL, z.B. Hetzner):
# DATABASE_URL="postgresql://user:password@host:5432/freibad_kiosk?schema=public"

# NextAuth
AUTH_SECRET="bitte-32-zufaellige-zeichen-hier-eintragen"
NEXTAUTH_URL="http://localhost:3000"

# Datei-Upload-Verzeichnis (für lokale Entwicklung)
UPLOAD_DIR="./public/uploads"

# Wetter (Bright Sky / DWD) - optional, keine API-Key nötig
WEATHER_LAT="52.5200"
WEATHER_LON="13.4050"
